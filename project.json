{
  "name": "falina-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/falina-web/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/falina-web",
        "command": "npm start"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/falina-web",
        "command": "npm run build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/falina-web",
        "command": "npx tsc -p tsconfig.app.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:noop"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/falina-web",
        "command": "npm test -- --watch=false"
      }
    }
  }
}
